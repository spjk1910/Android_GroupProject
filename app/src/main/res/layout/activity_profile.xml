    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:layout_marginLeft="67dp"
    android:layout_marginTop="346dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Current"
    android:textColor="#FFFFFFFF"
    android:textSize="20dp" />
  
  <TextView
    android:id="@+id/text_finished"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:layout_marginLeft="254dp"
    android:layout_marginTop="346dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Finished"
    android:textColor="#FFFFFFFF"
    android:textSize="20dp" />
  
  <ImageView
    android:id="@+id/container_line2"
    android:layout_width="376dp"
    android:layout_height="5dp"
    android:layout_marginRight="0dp"
    android:layout_marginTop="553dp"
    android:layout_gravity="top|center_horizontal"
    android:scaleType="centerInside"
    android:src="@drawable/container_line2" />
  
  <ImageView
    android:id="@+id/container_line3"
    android:layout_width="376dp"
    android:layout_height="5dp"
    android:layout_marginLeft="20dp"
    android:layout_marginTop="698dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/container_line3" />
  
  <ImageView
    android:id="@+id/image_ellipse1"
    android:layout_width="65dp"
    android:layout_height="65dp"
    android:layout_marginLeft="42dp"
    android:layout_marginTop="459dp"
    android:layout_gravity="top|left"
    android:background="@drawable/image_ellipse1"
    android:scaleType="centerInside" />
  
  <ImageView
    android:id="@+id/image_ellipse2"
    android:layout_width="65dp"
    android:layout_height="65dp"
    android:layout_marginLeft="42dp"
    android:layout_marginTop="740dp"
    android:layout_gravity="top|left"
    android:background="@drawable/image_ellipse2"
    android:scaleType="centerInside" />
  
  <ImageView
    android:id="@+id/image_ellipse3"
    android:layout_width="65dp"
    android:layout_height="65dp"
    android:layout_marginLeft="42dp"
    android:layout_marginTop="598dp"
    android:layout_gravity="top|left"
    android:background="@drawable/image_ellipse3"
    android:scaleType="centerInside" />
  
  <TextView
    android:id="@+id/text_setting"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_marginLeft="131dp"
    android:layout_marginTop="484dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Setting"
    android:textColor="#FF000000"
    android:textSize="25dp" />
  
  <TextView
    android:id="@+id/text_account_management"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_marginLeft="131dp"
    android:layout_marginTop="617dp"
