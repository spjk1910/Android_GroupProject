    android:text="Log-out"
    android:textColor="#FF000000"
    android:textSize="25dp" />
  
  <ImageView
    android:id="@+id/image_settings"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_marginLeft="59dp"
    android:layout_marginTop="477dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/image_settings" />
  
  <ImageView
    android:id="@+id/image_edit"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_marginLeft="366dp"
    android:layout_marginTop="18dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/image_edit" />
  
  <ImageView
    android:id="@+id/image_cloud_change"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_marginLeft="60dp"
    android:layout_marginTop="616dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/image_cloud_change" />
  
  <ImageView
    android:id="@+id/image_log_out"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_marginLeft="62dp"
    android:layout_marginTop="758dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/image_log_out" />


  <ImageView
    android:id="@+id/image_list"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="20dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/image_list" />

  <com.google.android.material.bottomnavigation.BottomNavigationView
      android:id="@+id/bottom_navigation"
      android:layout_width="match_parent"
      android:layout_height="60dp"
      android:layout_marginTop="850dp"

      android:layout_alignParentBottom="true"
      android:background="@drawable/bottom_navigation_background"
      app:menu="@menu/bottom_navigation_menu" />

</FrameLayout>
  </androidx.core.widget.NestedScrollView>
