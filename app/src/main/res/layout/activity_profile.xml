<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nested_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/container_profile"
  android:layout_width="match_parent"
  android:layout_height="917dp"
  android:background="@drawable/container_profile">
  
  <ImageView
    android:id="@+id/image_rectangle1"
    android:layout_width="412dp"
    android:layout_height="510dp"
    android:layout_marginTop="408dp"
    android:layout_gravity="top|left"
    android:background="@drawable/image_rectangle1"
    android:scaleType="centerInside" />
  

  <ImageView
    android:id="@+id/image_image"
    android:layout_width="150dp"
    android:layout_height="150dp"
    android:layout_marginTop="57dp"
    android:layout_gravity="top|center_horizontal"
    android:scaleType="centerInside"
    android:src="@drawable/image_image" />
  
  <TextView
    android:id="@+id/nameTextView"
    android:layout_width="wrap_content"
    android:layout_height="42dp"
    android:layout_marginLeft="0.5dp"
    android:layout_marginTop="221dp"
    android:layout_gravity="center_horizontal"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="JK"
    android:textColor="#FF000000"
    android:textSize="32dp" />
  
  <TextView
    android:id="@+id/text_username"
    android:layout_width="wrap_content"
    android:layout_height="21dp"
    android:layout_marginLeft="0.5dp"
    android:layout_marginTop="263dp"
    android:layout_gravity="center_horizontal"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="@spjk_ryan"
    android:textColor="#FF111111"
    android:textSize="16dp" />
  
  <ImageView
    android:id="@+id/image_rectangle3"
    android:layout_width="372dp"
    android:layout_height="72dp"
    android:layout_marginTop="310dp"
    android:layout_gravity="top|center_horizontal"
    android:scaleType="centerInside"
    android:src="@drawable/image_rectangle3" />
  
  <ImageView
    android:id="@+id/container_line1"
    android:layout_width="1dp"
    android:layout_height="72dp"
    android:layout_marginLeft="206dp"
    android:layout_marginTop="310dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/container_line1" />
  
  <TextView
    android:id="@+id/text_number2"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:layout_marginLeft="103dp"
    android:layout_marginTop="320dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="2"
    android:textColor="#FFFFFFFF"
    android:textSize="20dp" />
  
  <TextView
    android:id="@+id/text_number3"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:layout_marginLeft="296dp"
    android:layout_marginTop="320dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
