<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/container_credit_history"
  android:layout_width="match_parent"
  android:layout_height="917dp"
  android:background="@drawable/container_credit_history">
  
  <TextView
    android:id="@+id/text_credit_history_title"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginTop="27dp"
    android:layout_gravity="center_horizontal"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Credit History"
    android:textColor="#FF000000"
    android:textSize="24dp" />
  
  <TextView
    android:id="@+id/text_less_than"
    android:layout_width="wrap_content"
    android:layout_height="58dp"
    android:layout_marginLeft="30dp"
    android:layout_marginTop="23dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="&lt;"
    android:textColor="#FF000000"
    android:textSize="36dp" />
  
  <TextView
    android:id="@+id/text_invoice_id"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginLeft="13dp"
    android:layout_marginTop="110dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="InvoiceID: 123 456 789  "
    android:textColor="#FF000000"
    android:textSize="20dp" />
  
  <TextView
    android:id="@+id/text_date"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:layout_marginLeft="13dp"
    android:layout_marginTop="86dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="December.12.2024"
    android:textColor="#FF000000"
    android:textSize="16dp" />
  
  <TextView
    android:id="@+id/text_plus_1"
    android:layout_width="wrap_content"
    android:layout_height="39dp"
    android:layout_marginLeft="349dp"
    android:layout_marginTop="110dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
