<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/container_account_management"
  android:layout_width="match_parent"
  android:layout_height="917dp"
  android:background="@drawable/container_account_management">

  <TextView
      android:id="@+id/text_less_than"
      android:layout_width="wrap_content"
      android:layout_height="58dp"
      android:layout_gravity="top|left"
      android:layout_marginLeft="17dp"
      android:layout_marginTop="14dp"
      android:gravity="left|center_vertical"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:singleLine="true"
      android:text="&lt;"
      android:textColor="#FF000000"
      android:textSize="36dp" />
  
  <TextView
    android:id="@+id/text_account_management"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginTop="18dp"
    android:layout_gravity="center_horizontal"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Account Management"
    android:textColor="#FF000000"
    android:textSize="24dp" />
  
  <TextView
    android:id="@+id/text_account"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginLeft="18dp"
    android:layout_marginTop="72dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Account"
    android:textColor="#FF000000"
    android:textSize="20dp" />
  
  <TextView
    android:id="@+id/text_delete_account"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginLeft="19dp"
    android:layout_marginTop="298dp"
