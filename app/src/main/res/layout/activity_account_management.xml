    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Delete your account"
    android:textColor="#FFFF0000"
    android:textSize="20dp" />
  
  <ImageView
    android:id="@+id/image_trash"
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:layout_marginLeft="33dp"
    android:layout_marginTop="420dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/image_trash" />
  
  <TextView
    android:id="@+id/text_username_value"
    android:layout_width="wrap_content"
    android:layout_height="29dp"
    android:layout_marginLeft="318dp"
    android:layout_marginTop="124dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="spjk_ryan"
    android:textColor="#FF111111"
    android:textSize="18dp" />
  
  <TextView
    android:id="@+id/text_password_value"
    android:layout_width="wrap_content"
    android:layout_height="29dp"
    android:layout_marginLeft="302dp"
    android:layout_marginTop="220dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="************"
    android:textColor="#FF111111"
    android:textSize="18dp" />
  
  <TextView
    android:id="@+id/text_email_value"
    android:layout_width="wrap_content"
    android:layout_height="29dp"
    android:layout_marginLeft="235dp"
    android:layout_marginTop="172dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="spjk1910@gmail.com"
    android:textColor="#FF111111"
    android:textSize="18dp" />
</FrameLayout>
