    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Delete Account"
    android:textColor="#FFFF0000"
    android:textSize="20dp" />
  
  <TextView
    android:id="@+id/text_username"
    android:layout_width="wrap_content"
    android:layout_height="29dp"
    android:layout_marginLeft="18dp"
    android:layout_marginTop="123dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Username"
    android:textColor="#FF000000"
    android:textSize="18dp" />
  
  <TextView
    android:id="@+id/text_delete_confirmation"
    android:layout_width="wrap_content"
    android:layout_height="80.89dp"
    android:layout_marginLeft="17dp"
    android:layout_marginTop="326.56dp"
    android:layout_marginBottom="-11.44dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:lineHeight="28.94dp"
    android:maxLines="3"
    android:text="Once you delete your account, \nthere is no  going back.Please be certain"
    android:textColor="#FF000000"
    android:textSize="18dp" />
  
  <TextView
    android:id="@+id/text_email"
    android:layout_width="wrap_content"
    android:layout_height="29dp"
    android:layout_marginLeft="18dp"
    android:layout_marginTop="171dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Email"
    android:textColor="#FF000000"
    android:textSize="18dp" />
  
  <TextView
    android:id="@+id/text_password"
    android:layout_width="wrap_content"
    android:layout_height="29dp"
    android:layout_marginLeft="19dp"
    android:layout_marginTop="219dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Password"
    android:textColor="#FF000000"
    android:textSize="18dp" />
  
  <ImageView
    android:id="@+id/container_line"
    android:layout_width="376dp"
    android:layout_height="5dp"
    android:layout_marginRight="1dp"
    android:layout_marginTop="274dp"
    android:layout_gravity="top|center_horizontal"
    android:scaleType="centerInside"
    android:src="@drawable/container_line" />
  
  <ImageView
    android:id="@+id/image_ellipse"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_marginLeft="28dp"
    android:layout_marginTop="415dp"
    android:layout_gravity="top|left"
    android:background="@drawable/image_ellipse"
    android:scaleType="centerInside" />
  
  <TextView
    android:id="@+id/text_delete_your_account"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginLeft="76dp"
    android:layout_marginTop="418dp"
